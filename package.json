{
  "name": "lumen-music-player",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "node server.cjs",
    "preview": "vite preview",
    "android:sync": "cap sync android",
    "android:build": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "electron:start": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win",
    "app": "concurrently -k \"vite\" \"electron electron/main.cjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "music-metadata": "^7.14.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@distube/ytdl-core": "^5.1.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "electron-packager": "^17.1.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.lumen.music",
    "productName": "Lumen",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "Lumen-Setup.exe"
    },
    "files": [
      "dist/**/*",
      "!dist/*.exe",
      "!dist/*.apk",
      "!dist/*.zip",
      "electron/**/*",
      "package.json"
    ]
  }
}
