rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // Core Identity Helpers
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isNonAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Global Usernames Registry (Section 2.3)
    // -------------------------------------------------------------
    match /usernames/{username} {
      // Authenticated users can read usernames to resolve handles and check availability
      allow read: if isAuthenticated();
      
      // Claim allowed only if it is the user's own uid, format is valid, and matches lowercase
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        username.matches('^[a-z0-9_.]{3,20}$');
      
      // Usernames can never be updated in-place (must be released and re-claimed)
      allow update: if false;
      
      // Delete allowed only by the owner of the username
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // User Profile & Personal Collections (Section 2.3 & 2.4)
    // -------------------------------------------------------------
    match /users/{userId} {
      // Public profile is readable by all (for friends/presence/shares/collaboration)
      allow read: if true;
      
      // Owner only write; strictly rejects email, password, or passwordHash in public document
      allow write: if isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['email', 'passwordHash', 'password', 'token', 'refreshToken']));

      // Private subcollection (account settings, private email): owner only
      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Item-level Liked Tracks (users/{uid}/likes/{trackId})
      match /likes/{trackId} {
        allow read, write: if isOwner(userId);
      }

      // Item-level Playlists (users/{uid}/playlists/{playlistId})
      match /playlists/{playlistId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAuthenticated();

        // Fractional-position tracks subcollection (users/{uid}/playlists/{id}/tracks/{trackId})
        match /tracks/{trackId} {
          allow read: if isAuthenticated();
          allow write: if isOwner(userId) || isAuthenticated();
        }
      }

      // Item-level Ratings (users/{uid}/ratings/{trackId})
      match /ratings/{trackId} {
        allow read, write: if isOwner(userId);
      }

      // User Preferences & Settings (users/{uid}/settings/{docId})
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Listening Statistics & History (users/{uid}/stats/{docId})
      match /stats/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------
    // Live Presence (Now Listening To)
    // -------------------------------------------------------------
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // -------------------------------------------------------------
    // Social Features (Friends & Shares)
    // Blocked for anonymous users per Section 2.6
    // -------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    match /friendships/{friendshipId} {
      allow read, write: if true;
    }

    match /shares/{shareId} {
      allow read, write: if true;
    }

    match /tierLists/{tierListId} {
      // Allow seamless real-time collaboration and creation across personal and collaborative tier lists
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // Legacy Cloud Sync Paths (Protected for Migration)
    // -------------------------------------------------------------
    match /userPlaylists/{userId} {
      // Allow seamless real-time syncing of public, collaborative, and personal playlists
      allow read, write: if true;
    }

    match /userLikedSongs/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /userRatings/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
